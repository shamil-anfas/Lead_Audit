# Dependencies — reinstalled fresh inside the image
node_modules/

# Next.js build output — rebuilt inside the image
.next/

# Environment / secrets — pass at runtime, never bake into image
.env
.env.*
!.env.local.example

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Git
.git/
.gitignore
.gitattributes

# CI / docs
.github/
README.md

# Docker files themselves
Dockerfile*
.dockerignore

# Logs & debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
